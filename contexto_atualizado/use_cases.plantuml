@startuml
left to right direction
skinparam packageStyle rectangle
skinparam linetype polyline

actor Cliente
actor Passageiro
actor Funcionario
actor Gerente
actor Administrador
actor Transportadora

' Apenas organização visual
Cliente -[hidden]down- Passageiro
Passageiro -[hidden]down- Funcionario
Funcionario -[hidden]down- Gerente
Gerente -[hidden]down- Administrador

rectangle "Sistema VVV" {

  ' Casos de Uso do Cliente/Passageiro
  usecase "Cadastrar Cliente" as CadCliente
  usecase "Cadastrar Passageiro" as CadPassageiro
  usecase "Realizar Login" as Login
  usecase "Reservar viagem (compra online)" as ResOnline

  ' Pagamento
  usecase "Realizar pagamento" as Pagamento
  usecase "Calcular desconto" as Desconto
  usecase "Cadastrar menor de idade" as CadMenor
  usecase "Emitir ticket" as Ticket

  ' Tipos de pagamento
  usecase "Tipo de pagamento" as TipoPag
  usecase "Pagar no crédito" as PagCredito
  usecase "Pagar no débito" as PagDebito
  usecase "Pagar com Pix" as PagPix

  ' Funcionário
  usecase "Reservar viagem (presencial)" as ResFisica
  usecase "Visualizar modais" as VisModais

  ' Gerente
  usecase "Autorizar funcionário" as Autorizar
  usecase "Visualizar reservas" as VisRes
  usecase "Aprovar venda online" as Aprovar
  usecase "Informar manutenção de modal" as Manutencao

  ' Administrador
  usecase "Cadastrar Cidade" as CadCidade
  usecase "Cadastrar Modal" as CadModal
  usecase "Cadastrar Viagem" as CadViagem
}

'------------------------
' Associações dos atores
'------------------------

Cliente -- CadCliente
Cliente -- CadPassageiro
Cliente -- Login
Cliente -- ResOnline

Passageiro -- CadPassageiro
Passageiro -- Ticket

Funcionario -- ResFisica
Funcionario -- VisModais

Gerente -- Autorizar
Gerente -- VisRes
Gerente -- Aprovar
Gerente -- Manutencao

Transportadora -- Manutencao

Administrador -- CadCidade
Administrador -- CadModal
Administrador -- CadViagem

'------------------------
' Relações entre casos de uso
'------------------------

Ticket ..> ResOnline : <<include>>
Ticket ..> ResFisica : <<include>>

ResOnline -- Pagamento
ResFisica -- Pagamento

VisRes -- Aprovar

Desconto ..> Pagamento : <<extend>>

CadPassageiro <|-- CadMenor

'------------------------
' Generalização de pagamento
'------------------------

Pagamento <|-- TipoPag
TipoPag <|-- PagCredito
TipoPag <|-- PagDebito
TipoPag <|-- PagPix

@enduml